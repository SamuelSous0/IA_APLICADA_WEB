# URL base do serviço de classificação de imagens (mantida apenas no servidor)
API_BASE_URL=https://projeto-harduino-ia.onrender.com

# Porta local do servidor web
PORT=3000

# Timeout em milissegundos (Render Free pode levar ~30-50s para acordar)
REQUEST_TIMEOUT_MS=60000

# Tamanho máximo permitido para upload de imagem (em MB)
MAX_UPLOAD_MB=5

# Opcional: caso a API passe a exigir chave de autenticação no futuro
# API_KEY=sua_chave_secreta_aqui
